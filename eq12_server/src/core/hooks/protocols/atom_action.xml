<atom_actions>

<!-- 说话：说的一句话 -->
<atom_action>
<queue>tts</queue>
<text>你好呀</text>
</atom_action>

<!-- 腿：整条指令写进 text；动词 forward,back,left,right,pan,tilt,stop,center，时长可写 3 / 1.5s / 800ms / 2秒 -->
<atom_action>
<queue>pub/leg</queue>
<text>forward,50,2</text>
</atom_action>

<atom_action>
<queue>pub/leg</queue>
<text>pan,90</text>
</atom_action>

<atom_action>
<queue>pub/leg</queue>
<text>center</text>
</atom_action>

<!-- 表情：idle / listen / think / speak / happy / sleep -->
<atom_action>
<queue>pub/face</queue>
<text>happy</text>
</atom_action>

<!-- 拍照：拍完照片异步从 sub/eye 回来 -->
<atom_action>
<queue>pub/eye</queue>
<text>photo</text>
</atom_action>

<!-- 这台电脑·按键：value 是键名，type 是 keyboard；time 是按住秒数，不写缺省 0.05 -->
<atom_action>
<queue>_pub/desktop</queue>
<type>keyboard</type>
<value>A</value>
</atom_action>

<atom_action>
<queue>_pub/desktop</queue>
<type>keyboard</type>
<value>CTRLALTDELETE</value>
</atom_action>

<atom_action>
<queue>_pub/desktop</queue>
<type>keyboard</type>
<value>ENTER</value>
<time>0.2</time>
</atom_action>

<!-- 这台电脑·鼠标：相对移动，direction 是 UP / DOWN / LEFT / RIGHT，value 是像素 -->
<atom_action>
<queue>_pub/desktop</queue>
<type>mouse</type>
<direction>UP</direction>
<value>12</value>
</atom_action>

<!-- 这台电脑·滚轮：direction 是 UP / DOWN，value 是格数 -->
<atom_action>
<queue>_pub/desktop</queue>
<type>scroll</type>
<direction>DOWN</direction>
<value>5</value>
</atom_action>

<!-- 这台电脑·截屏：结果进 _sub/desktop，按 type == screen 认 -->
<atom_action>
<queue>_pub/desktop</queue>
<type>screenshot</type>
</atom_action>

<!-- 这台电脑·写剪贴板：value 空串就是清空；配合 keyboard 的 CTRLV 粘到别处 -->
<atom_action>
<queue>_pub/desktop</queue>
<type>clipboard</type>
<value>要写进剪贴板的文字</value>
</atom_action>

<!-- 飞书·文字：发回消息来的那个会话 -->
<atom_action>
<queue>_pub/feishu</queue>
<text>你好</text>
</atom_action>

<!-- 飞书·图片：img 写图片路径 -->
<atom_action>
<queue>_pub/feishu</queue>
<img>cache/screen_001.jpg</img>
</atom_action>

<!-- 到点再叫我：in 是秒数，自己乘好（15 分钟写 900）；投完立刻返回，别 sleep 等 -->
<atom_action>
<queue>_pub/delay</queue>
<text>提醒我喝水</text>
<in>900</in>
</atom_action>

</atom_actions>
